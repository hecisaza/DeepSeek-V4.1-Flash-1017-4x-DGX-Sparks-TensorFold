Subject: a DSML block closes at its first closer between invokes, so a value holding the block's tags stays in the call

diff --git a/zig/src/server/reply_text.zig b/zig/src/server/reply_text.zig
index 8b132bc4..9947ef91 100644
--- a/zig/src/server/reply_text.zig
+++ b/zig/src/server/reply_text.zig
@@ -32,6 +32,79 @@ fn find(text: []const u8, tag: []const u8) ?usize {
     return findTag(text, 0, tag);
 }
 
+/// The invoke and parameter tags of a DSML spelling, by its block's opener (null: not a DSML block).
+const Dsml = struct { invoke_open: []const u8, invoke_close: []const u8, param_open: []const u8, param_close: []const u8 };
+
+fn dsmlTags(opener: []const u8) ?Dsml {
+    const D = "\u{ff5c}DSML\u{ff5c}";
+    if (std.mem.eql(u8, opener, "<" ++ D ++ " calls>")) return .{ .invoke_open = "<" ++ D ++ " invoke name=\"", .invoke_close = "</" ++ D ++ " invoke>", .param_open = "<" ++ D ++ " parameter name=\"", .param_close = "</" ++ D ++ " parameter>" };
+    if (std.mem.eql(u8, opener, "<" ++ D ++ "tool_calls>")) return .{ .invoke_open = "<" ++ D ++ "invoke name=\"", .invoke_close = "</" ++ D ++ "invoke>", .param_open = "<" ++ D ++ "parameter name=\"", .param_close = "</" ++ D ++ "parameter>" };
+    return null;
+}
+
+/// Whether ``rest`` is a proper start of ``tag``: the tag may still be being written.
+fn begins(rest: []const u8, tag: []const u8) bool {
+    return rest.len < tag.len and std.mem.startsWith(u8, tag, rest);
+}
+
+const Walk = union(enum) { closer: usize, more, broken };
+
+/// Reads a DSML block from ``from`` (just past its opener) the way the parser reads its parts: invokes, each a name and
+/// parameters, each value running to the first parameter closer after it. The block's closer is the first one met
+/// between those parts, so a closer or an opener inside a value neither ends nor splits the block. ``more``: the text
+/// ends inside the block; ``broken``: something other than those parts appears.
+fn walkDsml(text: []const u8, from: usize, t: Dsml, closer: []const u8) Walk {
+    var p = from;
+    while (true) {
+        while (p < text.len and isSpaceByte(text[p])) p += 1;
+        if (p >= text.len) return .more;
+        const rest = text[p..];
+        if (std.mem.startsWith(u8, rest, closer)) return .{ .closer = p };
+        if (!std.mem.startsWith(u8, rest, t.invoke_open)) return if (begins(rest, closer) or begins(rest, t.invoke_open)) .more else .broken;
+        const q = std.mem.indexOfScalarPos(u8, text, p + t.invoke_open.len, '"') orelse return .more;
+        if (q + 2 > text.len) return .more;
+        if (!std.mem.startsWith(u8, text[q..], "\">")) return .broken;
+        p = q + 2;
+        while (true) {
+            while (p < text.len and isSpaceByte(text[p])) p += 1;
+            if (p >= text.len) return .more;
+            const r = text[p..];
+            if (std.mem.startsWith(u8, r, t.invoke_close)) {
+                p += t.invoke_close.len;
+                break;
+            }
+            if (!std.mem.startsWith(u8, r, t.param_open)) return if (begins(r, t.invoke_close) or begins(r, t.param_open)) .more else .broken;
+            const nq = std.mem.indexOfScalarPos(u8, text, p + t.param_open.len, '"') orelse return .more;
+            var v = nq + 1;
+            for ([_][]const u8{ " string=\"true\"", " string=\"false\"" }) |attr| {
+                if (std.mem.startsWith(u8, text[v..], attr)) {
+                    v += attr.len;
+                    break;
+                }
+                if (begins(text[v..], attr)) return .more;
+            }
+            if (v >= text.len) return .more;
+            if (text[v] != '>') return .broken;
+            const pe = findTag(text, v + 1, t.param_close) orelse return .more;
+            p = pe + t.param_close.len;
+        }
+    }
+}
+
+/// Where the call block opened before ``from`` closes: the index of its closer, or null while it is open. A DSML
+/// block's string values are not escaped, so a value can hold the block's own closer (a file about DSML): the block
+/// closes at the first closer met between its parts (``walkDsml``), not at one inside a value, and a reply that ends
+/// inside the block leaves it open, as a block with no closer is. A block that does not read as invokes and
+/// parameters keeps the rule every other markup has: the first closer after the opener.
+pub fn blockEnd(text: []const u8, from: usize, opener: []const u8, closer: []const u8) ?usize {
+    if (dsmlTags(opener)) |t| switch (walkDsml(text, from, t, closer)) {
+        .closer => |at| return at,
+        .more => return null,
+        .broken => {},
+    };
+    return findTag(text, from, closer);
+}
+
 pub fn isChannel(m: Markers) bool {
     return std.mem.eql(u8, m.close, channel_markers.close);
 }
