diff --git a/zig/src/server/reply_text.zig b/zig/src/server/reply_text.zig
index 8b132bc..768202f 100644
--- a/zig/src/server/reply_text.zig
+++ b/zig/src/server/reply_text.zig
@@ -32,6 +32,19 @@ fn find(text: []const u8, tag: []const u8) ?usize {
     return findTag(text, 0, tag);
 }
 
+fn isDsml(opener: []const u8) bool {
+    return std.mem.indexOf(u8, opener, "\u{ff5c}DSML\u{ff5c}") != null;
+}
+
+/// Where the call block opened before ``from`` closes: the index of its closer. A DSML block closes at the last closer
+/// before the next opener, since its string values are not escaped: a value that holds the closer (a file about DSML)
+/// would otherwise end the block early, drop the call, and leave the block's own closers as the reply's text.
+pub fn blockEnd(text: []const u8, from: usize, opener: []const u8, closer: []const u8) ?usize {
+    if (!isDsml(opener)) return findTag(text, from, closer);
+    const limit = findTag(text, from, opener) orelse text.len;
+    return if (std.mem.lastIndexOf(u8, text[from..limit], closer)) |i| from + i else null;
+}
+
 pub fn isChannel(m: Markers) bool {
     return std.mem.eql(u8, m.close, channel_markers.close);
 }
@@ -125,7 +138,9 @@ pub fn hideInto(a: Allocator, out: *std.ArrayList(u8), text: []const u8, finishe
         }
         try out.appendSlice(a, text[pos..start.?]);
         const opener = calls[which][0];
-        const end = findTag(text, start.? + opener.len, calls[which][1]) orelse return out.items;
+        // a later closer may still close a DSML block (blockEnd), so it stays hidden until the reply ends
+        if (!finished and isDsml(opener)) return out.items;
+        const end = blockEnd(text, start.? + opener.len, opener, calls[which][1]) orelse return out.items;
         pos = end + calls[which][1].len;
     }
 }
