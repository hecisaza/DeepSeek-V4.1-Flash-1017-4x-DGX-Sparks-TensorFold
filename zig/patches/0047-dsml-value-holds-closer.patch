diff --git a/zig/src/server/tool_parse_test.zig b/zig/src/server/tool_parse_test.zig
index 5516e48..c03f14e 100644
--- a/zig/src/server/tool_parse_test.zig
+++ b/zig/src/server/tool_parse_test.zig
@@ -151,3 +151,38 @@ test "DeepSeek-V4.1's DSML calls, read as the served lane reads them" {
     const open = "Hi.<" ++ D ++ " calls>\n<" ++ D ++ " invoke name=\"weather\">";
     try std.testing.expectEqualStrings(open, (try parse(a, open, tools, null)).content);
 }
+
+test "a DSML value that holds the block's closer stays in the call, and no closer reaches the text" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const reply_text = @import("reply_text.zig");
+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"write\"}}]")).ok.array;
+    const D = "\u{ff5c}DSML\u{ff5c}";
+    // DeepSeek-V4.1's spelling and V4's: a file written by the call ends with the block's own closer
+    const blocks = [_][2][]const u8{
+        .{ "<" ++ D ++ " calls>\n<" ++ D ++ " invoke name=\"write\">\n<" ++ D ++ " parameter name=\"content\" string=\"true\">end: </" ++ D ++ " calls></" ++ D ++ " parameter>\n</" ++ D ++ " invoke>\n</" ++ D ++ " calls>", "{\"content\":\"end: </" ++ D ++ " calls>\"}" },
+        .{ "<" ++ D ++ "tool_calls>\n<" ++ D ++ "invoke name=\"write\">\n<" ++ D ++ "parameter name=\"content\" string=\"true\">end: </" ++ D ++ "tool_calls></" ++ D ++ "parameter>\n</" ++ D ++ "invoke>\n</" ++ D ++ "tool_calls>", "{\"content\":\"end: </" ++ D ++ "tool_calls>\"}" },
+    };
+    for (blocks) |b| {
+        const r = try parse(a, b[0], tools, null);
+        try std.testing.expectEqual(@as(usize, 1), r.calls.?.len);
+        try std.testing.expectEqualStrings(b[1], r.calls.?[0].get("function").?.get("arguments").?.string);
+        try std.testing.expectEqualStrings("", r.content);
+        // streamed: nothing of the block shows while it is written, nor when it ends
+        for (0..b[0].len + 1) |n| try std.testing.expectEqualStrings("", try reply_text.hideToolCalls(a, b[0][0..n], false));
+        try std.testing.expectEqualStrings("", try reply_text.hideToolCalls(a, b[0], true));
+        // prose around the block: before it streams, after it shows when the reply ends
+        const around = try std.mem.concat(a, u8, &.{ "Writing.\n\n", b[0], "\nDone." });
+        try std.testing.expectEqualStrings("Writing.\n\n", try reply_text.hideToolCalls(a, around, false));
+        try std.testing.expectEqualStrings("Writing.\n\n\nDone.", try reply_text.hideToolCalls(a, around, true));
+        try std.testing.expectEqualStrings("Writing.\n\n\nDone.", (try parse(a, around, tools, null)).content);
+    }
+    // two blocks: each closes before the next one opens, so the prose between them stays
+    const one = blocks[0][0];
+    const twice = try std.mem.concat(a, u8, &.{ one, "\nThen.\n", one });
+    const r2 = try parse(a, twice, tools, null);
+    try std.testing.expectEqual(@as(usize, 2), r2.calls.?.len);
+    try std.testing.expectEqualStrings("Then.", r2.content);
+    try std.testing.expectEqualStrings("\nThen.\n", try reply_text.hideToolCalls(a, twice, true));
+}
